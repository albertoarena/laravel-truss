# Dependencies
/vendor/
# The package's own lock, and only it: no leading slash would match at every
# level, which swallowed build/composer.lock. That one IS committed, because it
# is the bill of materials of a binary people download rather than noise for a
# library's consumers, and without it two builds of one tag can bundle
# different Illuminate patch versions under the same version number.
/composer.lock
/node_modules/
# package-lock.json IS committed. Nothing in package.json reaches an installer
# (it is export-ignored), so the lock pins only the test toolchain, and without
# it CI took whatever package.json allowed on the day: Mermaid 11.17 and
# Playwright 1.65 each turned an unrelated pull request red.

# Playwright
/test-results/
/playwright-report/
/.playwright/

# Test / tooling caches
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# build/ holds the PHAR's dependency manifest and is tracked source, so only
# what Composer and Box write inside it is ignored. This entry used to be
# /build/ outright, which silently swallowed build/composer.json the day it
# was added: git add -A reported nothing and the manifest existed on one disk.
/build/vendor/
/truss.phar

# Private/local docs (note: the tracked docs/ folder is NOT ignored).
# No trailing slash on purpose: a trailing slash matches directories only, so
# the entry would not cover a symlink of the same name, and git records a
# symlink as a file. Without the slash it covers both.
/.docs

# IDE files
/.idea/
/.vscode/
*.iml

# Local Claude and agent files
CLAUDE.local.md
CLAUDE.*.local.md
AGENTS.local.md

# Workspace snapshot archives: these capture vendor/, node_modules/ and the
# gitignored .docs/, so one was committed by accident on 18/08/2026.
*.tar

# Built by tests/e2e/exported-file.spec.js, never committed.
/tests/e2e/.tmp/
