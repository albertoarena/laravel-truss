* text=auto eol=lf

# Keep the Composer/dist package lean: exclude development-only files.
# Runtime assets under resources/ (views, css, js, vendored Mermaid, fonts) ship.
/.github            export-ignore
/art                export-ignore
/docs               export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/package.json       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/playwright.config.js export-ignore
/vitest.config.js   export-ignore

# The console layer: the framework-free CLI, its entry point and the PHAR build
# manifest. These live here so the binary and the package are built from one
# tag, but an installer must never receive them: they need Symfony Console and
# the Illuminate CLI packages that build/composer.json pins for the PHAR alone,
# while the package's own require stays thin. Guarded by tests/Feature/DistArchiveTest.php.
/bin                export-ignore
/box.json           export-ignore
/build              export-ignore
/src/Cli            export-ignore

# The vendored Mermaid bundle is 3.5 MB of minified third-party JavaScript and
# is not auto-detected as vendored under resources/js/vendor/. Left in, it alone
# labels the whole repo JavaScript. Mark it vendored so it is excluded.
resources/js/vendor/**   linguist-vendored

# Exclude the JavaScript test suites (Playwright e2e + Vitest) from language
# stats too. The shipped PHP and the frontend modules under resources/js are
# what represent the package; without this the JS tests tip the balance off PHP.
tests/e2e/**        linguist-vendored
tests/js/**         linguist-vendored
